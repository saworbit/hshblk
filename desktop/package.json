{
  "name": "hshblk-desktop",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "devEngines": {
    "packageManager": { "name": "npm", "version": ">=11.11.0", "onFail": "error" }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "licences": "node scripts/licences.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.8.0",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.3",
    "@tauri-apps/api": "^2.12.4",
    "entities": "^8.1.0",
    "gemoji": "^8.1.0",
    "katex": "^0.19.0",
    "mermaid": "^11.17.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    }
  }
}
